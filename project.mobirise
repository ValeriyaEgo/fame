        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 26px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 26px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              "padding": "200px 0 200px 60px",
              "background-color": "@container",
              "border-radius": "20px",
              "display": "flex",
              "align-items": "center",
              "& when (@reverseContent)": {
                "padding": "200px 60px 200px 0",
                "@media (max-width: 992px)": {
                  "padding": "100px 20px"
                }
              },
              "@media (max-width: 992px)": {
                "padding": "100px 20px",
                "display": "block"
              },
              ".content-wrap": {
                "width": "45%",
                "padding-right": "45px",
                "& when (@reverseContent)": {
                  "padding-right": "0",
                  "padding-left": "45px",
                  "@media (max-width: 992px)": {
                    "padding-left": "0"
                  }
                },
                "@media (max-width: 1440px)": {
                  "width": "55%"
                },
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "padding-right": "0",
                  "margin-bottom": "40px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "40px"
                },
                ".mbr-section-subtitle": {
                  "margin-bottom": "16px"
                },
                ".mbr-text": {
                  "margin-bottom": "16px"
                },
                ".icon-wrapper": {
                  "&:hover, &:focus": {
                    ".mbr-iconfont": {
                      "padding-top": "20px"
                    }
                  },
                  ".mbr-iconfont": {
                    "display": "inline-flex",
                    "width": "50px",
                    "height": "50px",
                    "font-size": "50px",
                    "transition": "all 0.3s ease-in-out",
                    "color": "@icon"
                  }
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
