              "min-width": "75%",
              "max-width": "75%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".item-img": {
                    "img": {
                      "height": "600px",
                      "object-fit": "cover",
                      "border-radius": "0 !important",
                      "@media (max-width: 992px)": {
                        "height": "350px"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "25px",
              "height": "25px",
              "margin-top": "-1.5rem",
              "font-size": "25px",
              "background-color": "transparent !important",
              "color": "@primaryColor !important",
              "border": "none !important",
              "border-radius": "0",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "opacity": ".6 !important"
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "0"
              },
              "@media (max-width: 992px)": {
                "top": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "55%",
              "@media (max-width: 1440px)": {
                "width": "45%"
              },
              "@media (max-width: 992px)": {
                "width": "100%"
              },
              "@media (max-width: 768px)": {
                "& when (@arrows)": {
                  "padding-top": "25px"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".icon-wrapper": {
              "text-align": "center"
            },
            ".mbr-section-title, .icon-wrapper": {
              "color": "#312911"
            }
          },
          "_name": "slider05",
          "_sourceTheme": "printm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider05 mbr-embla printm5\" group=\"Sliders &amp; Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked=\"\">\n        <input type=\"color\" title=\"Icon Color\" value=\"#0f4229\" name=\"icon\" condition=\"showIcon\" selected=\"\">\n        <input type=\"color\" title=\"Container BG\" value=\"#F4F1F1\" name=\"container\" selected=\"\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked=\"\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"2\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked=\"\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"25\" step=\"5\" value=\"0\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"content-wrap\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .icon-wrapper\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Brands</b></h2>\n                        <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\"><i>Francesco Molon</i></h3>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .text-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                FAmeStudioAgency proudly represents leading European brands recognized for exceptional craftsmanship, refined quality, and forward-thinking design in furniture and lighting.<br><br>We continuously expand our reach, visiting partners, presenting new models and finishes, and implementing unique brand-promotion programs that help our manufacturers grow their presence and reputation in Europe<br><br></p>\n                        </div>\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <a href=\"#\"><span class=\"mobi-mbri mobi-mbri-down mbr-iconfont\"></span></a>\n                        </div>\n                    </div>\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/250409-molon-salone-25-543-700x1050.jpg\" alt=\"Mobirise\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                \n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/250409-molon-salone-25-0491-1-700x1050.jpg\" alt=\"Mobirise\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/-49a6208-1-700x1050.jpg\" alt=\"Mobirise\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/250409-molon-salone-25-240-700x1050.jpg\" alt=\"Mobirise\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                \n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u6kyDEioZ3",
          "_anchor": "slider05-c",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 26px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 26px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".items-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "45px",
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".item": {
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                "&:focus, &:hover": {
                  ".item-wrapper .item-img img": {
                    "transform": "scale(1)"
                  }
                },
                ".item-wrapper": {
                  "display": "flex",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".item-content": {
                    "width": "50%",
                    "padding-right": "20px",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "margin-bottom": "20px",
                      "padding-right": "0"
                    },
                    ".item-title": {
                      "margin-bottom": "5px"
                    },
                    ".item-desc": {
                      "margin-bottom": "0",
                      "padding-bottom": "5px",
                      "border-bottom": "1px solid @border"
                    }
                  },
                  ".item-img": {
                    "width": "50%",
                    "border-radius": "20px",
                    "overflow": "hidden",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    "img": {
                      "height": "340px",
                      "object-fit": "cover",
                      "transform": "scale(1.15)",
                      "transition": "all 0.3s ease-in-out"
                    }
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "50px",
              "@media (max-width: 992px)": {
                "margin-top": "0"
              },
              "text-align": "center"
            },
            ".item-title": {
              "color": "#000000"
            },
            ".item-desc": {
              "color": "#000000"
            },
            ".item-title, .mbr-section-btn": {
              "color": "#312911"
            }
          },
          "_name": "features01",
          "_sourceTheme": "printm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features01 printm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#000000\" name=\"border\" condition=\"showDesc\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"items-wrapper\">\n                    \n                    \n                    <div class=\"item features-image active\">\n                        \n                            <div class=\"item-wrapper\">\n                                <div class=\"item-content\">\n                                    <a href=\"https://www.francescomolon.com/\" target=\"_blank\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>Francesco Molon (Italy)</b></h4>\n                                    </a>    \n                                    <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">\n                                        <br><b>Italian Premium Furniture Manufacturer</b><br><br>For decades, Francesco Molon has been synonymous with exceptional craftsmanship, refined materials, and distinctive Italian design. The brand is internationally recognized for its ability to combine tradition with contemporary interpretation, offering collections that range from classic elegance to modern luxury.<br><br>Francesco Molon furniture is widely specified by:<br>• interior designers<br>• architects and project planners<br>• private clients seeking bespoke, high-quality interiors<br><br>Each collection reflects a unique design language, meticulous attention to detail, and uncompromising standards of production<br></p>\n                                </div>\n                                \n                                <div class=\"item-img\">\n                                    <a href=\"https://www.francescomolon.com/\" target=\"_blank\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/250409-molon-salone-25-0576-1-506x704.jpg\" alt=\"Francesco Molon\" title data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                </a>  \n                                        </div>\n                                   \n                            </div>\n                        \n                    </div>\n                    <div class=\"item features-image\">\n                        \n                            <div class=\"item-wrapper\">\n                                <div class=\"item-content\">\n                                    <a href=\"https://www.unitedalabaster.com/en/\" target=\"_blank\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>United Alabaster (Spain)</b></h4>\n                                    </a>\n                                    <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\"><br><b>Spanish Premium Lighting Manufacturer<br></b><br>FAme Studio also represents United Alabaster, a Spanish manufacturer specializing in premium lighting made from natural alabaster.<br><br>United Alabaster is known for its sculptural approach to light, where each piece becomes both a<br>functional object and a design statement. <br>The use of natural alabaster gives every luminaire a unique character, creating warm, atmospheric lighting with a strong architectural presence.<br><br>The brand is highly regarded by designers and architects for:<br>• its distinctive materiality<br>• timeless, minimalist aesthetics<br>• suitability for high-end residential and hospitality projects<br></p>\n                                </div>\n                                <div class=\"item-img\">\n                                    <a href=\"https://www.unitedalabaster.com/en/\" target=\"_blank\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/unitedalabaster-pendantlamp-superloft-416x625.jpg\" alt=\"United Alabaster\" title data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                    </a>\n                                </div>\n                            </div>\n                        \n                    </div>\n                </div>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-warning\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        REQUEST CATALOG</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u6kyrNl3y4",
          "_anchor": "features01-2",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "form1",
          "_sourceTheme": "formulam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"formulam5 form1\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen}\" plugins=\"formstyler, datepicker\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<header>Background</header>\n\t\t<input type=\"color\" name=\"bgColor\" title=\"Color\" value=\"#f4f1f1\" selected>\n\t\t<input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row content-wrapper justify-content-center\">\n\t\t\t<div mbr-form class=\"col-lg-7 mbr-form\">\n<!--Formbuilder Form-->\n<form action=\"hello.famestudio@gmail.com\" name=\"CatalogRequest\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"hello.famestudio@gmail.com\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Your catalogs are on the way.</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12\">\n<h5 mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" class=\"mbr-section-title mbr-fonts-style mb-5\">Subscribe&nbsp;</h5>\n</div>\n<div class=\"col-lg-6 col-md-6 col-sm-12 p-0 form-group\" data-for=\"email\">\n<input type=\"email\" name=\"email\" placeholder=\"Add your email...\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n</div>\n<div class=\"col-auto mbr-section-btn p-0 m-0\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 w-100 w-100 w-100 w-100 w-100 w-100 btn btn-warning\" data-app-placeholder=\"Type Text\">GET CATALOG</a></div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n\t\t</div>\n\t</div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "background-color": "@bgColor",
            "input": {
              "padding": "1rem 1.5rem",
              "border": "none !important",
              "height": "100%",
              "box-shadow": "none !important",
              "font-size": "1rem",
              "border-radius": "2rem !important",
              "&:hover": {
                "border": "none !important",
                "box-shadow": "none"
              }
            },
            ".btn, .wrapper": {
              "border-radius": "2rem !important"
            },
            ".btn": {
              "height": "100%",
              "margin": "auto",
              "@media (max-width: 767px)": {
                "width": "100%"
              }
            },
            ".mbr-section-btn": {
              "@media (max-width: 767px)": {
                "width": "100%"
              },
              "display": "flex",
              "margin-bottom": "1.2rem",
              "width": "fit-content",
              ".btn": {
                "width": "auto"
              }
            },
            ".text-wrapper": {
              "@media (min-width: 992px)": {
                "padding": "0 2rem"
              }
            },
            ".form-group": {
              "margin": "0"
            },
            ".wrapper": {
              "background": "white",
              "border-radius": "2rem !important",
              "width": "80%",
              "padding": "0",
              "overflow": "hidden",
              "border": "1px solid lightgray",
              "margin": "auto",
              "justify-content": "space-between",
              "display": "flex",
              "@media (max-width: 767px)": {
                "border-radius": "1.6rem"
              }
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "2rem"
              },
              ".content-wrapper": {
                "flex-direction": "column-reverse"
              }
            },
            ".justify-content-center": {
              "align-items": "center"
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#4e423d"
            },
            "H5": {
              "color": "#312911"
            },
            ".alert-success": {
              "background-color": "#f0f0f0 !important",
              "color": "#000 !important",
              "border": "none !important"
            }
          },
          "_cid": "v3uGNBZ3d2",
          "_anchor": "form1-15",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 26px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 26px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              "display": "flex",
              "padding": "100px 60px",
              "background-color": "@container",
              "border-radius": "20px",
              "@media (max-width: 992px)": {
                "padding": "100px 20px",
                "display": "block",
                "height": "auto"
              },
              ".image-wrapper": {
                "width": "50%",
                "padding-right": "45px",
                "margin-bottom": "0",
                "& when (@reverseContent)": {
                  "padding-right": "0",
                  "padding-left": "60px",
                  "@media (max-width: 992px)": {
                    "padding-left": "0"
                  }
                },
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "padding-right": "0",
                  "margin-bottom": "40px"
                },
                ".image-wrap": {
                  "margin-right": "80px",
                  "margin-bottom": "20px",
                  "@media (max-width: 992px)": {
                    "margin-right": "0"
                  },
                  "&:nth-child(2n)": {
                    "margin-right": "0",
                    "margin-left": "80px",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "margin-left": "0"
                    }
                  },
                  "img": {
                    "height": "600px",
                    "object-fit": "cover",
                    "@media (max-width: 992px)": {
                      "height": "350px"
                    }
                  }
                }
              },
              ".content-wrap": {
                "width": "50%",
                "padding-top": "100px",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "padding-top": "0"
                },
                ".title-wrapper": {
                  "margin-bottom": "60px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "40px"
                  },
                  ".mbr-section-title": {
                    "margin-bottom": "30px"
                  },
                  ".mbr-text": {
                    "margin-bottom": "0"
                  }
                },
                ".panel-group": {
                  ".card": {
                    "border-radius": "0 !important",
                    "background-color": "transparent",
                    "margin-bottom": "50px",
                    "padding": "0",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "40px"
                    },
                    ".card-header": {
                      "background-color": "transparent",
                      "border": "none",
                      "border-radius": "0",
                      "padding": "10px",
                      ".panel-title": {
                        "display": "inline-flex",
                        "align-items": "center",
                        ".panel-title-edit": {
                          "margin-bottom": "0"
                        },
                        ".mbr-iconfont": {
                          "display": "inline-flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "font-size": "16px",
                          "width": "16px",
                          "height": "16px",
                          "min-width": "16px",
                          "transition": "all 0.3s ease-in-out",
                          "color": "@icon",
                          "margin-left": "10px"
                        },
                        "&:not(.collapsed)": {
                          ".mbr-iconfont": {
                            "transform": "rotate(45deg)"
                          }
                        }
                      }
                    },
                    ".panel-collapse": {
                      ".panel-body": {
                        "margin-top": "20px",
                        ".panel-text": {
                          "padding": "10px"
                        }
                      }
                    }
                  }
                },
                ".mbr-section-btn": {
                  "margin-top": "20px",
                  ".btn": {
                    "width": "70%",
                    "@media (max-width: 1200px)": {
                      "width": "100%"
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".panel-title-edit": {
              "color": "#000000"
            },
            ".panel-text": {
              "color": "#000000"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#312911"
            }
          },
          "_name": "list02",
          "_sourceTheme": "printm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list02 printm5\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Image 1\" name=\"showImage_1\" checked>\n        <input type=\"checkbox\" title=\"Image 2\" name=\"showImage_2\">\n        <input type=\"color\" title=\"Container BG\" value=\"#f4f1f1\" name=\"container\" selected>\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"image-wrapper\">\n                        <div class=\"image-wrap\" mbr-if=\"showImage_1\">\n                            <img src=\"@PROJECT_PATH@/assets/images/untitled20design2040-687x859.jpeg\" alt=\"Mobirise\">\n                        </div>\n                        <div class=\"image-wrap\" mbr-if=\"showImage_2\">\n                            <img src=\"@THEME_PATH@/components/_images/print/image10.jpg\" alt=\"Mobirise\">\n                        </div>\n                    </div>\n                    <div class=\"content-wrap\">\n                        <div class=\"title-wrapper\" mbr-if=\"showTitle || showText\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\"><b>Team</b></h2>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Behind every successful project stands a dedicated team. <br><br><b>We believe in:<br></b>• long-term value over trends<br>• quality over quantity<br>• clear identity over generic solutions<br>Our role is to connect outstanding European manufacturers with professionals and clients who value design integrity, craftsmanship, and reliability.<br><br>FAme Studio provides fast and responsive support. Our team operates 24/7, including weekends and holidays, ensuring that urgent requests, changes, and coordination issues are addressed without delay.<br><br>We supply all necessary project materials - samples, technical data, finishes, and documentation- to any location worldwide in the shortest possible time. We also assist with specification development and product selection, taking into account the full production capabilities and customization options of each manufacturer.<br><br>FAme Studio is a reliable European partner for professionals who value quality, accountability, and long-term collaboration.<br><br>We work closely with designers, architects, developers, and private clients, offering:<br></p>\n                        </div>\n                        <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                            <div class=\"card\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .card-header\"><b>Training Sessions</b></h4>\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </a>\n                                </div>\n                                <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n                                            Comprehensive staff education on products and capabilities.</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .card-header\">\n                                            <b>Consulting</b>\n                                        </h4>\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </a>\n                                </div>\n                                <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n                                            Expert guidance on product ranges and technical specifications.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .card-header\"><b>Project</b><i> </i><b>Support</b></h4>\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </a>\n                                </div>\n                                <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n                                            Assistance with order placement and project management.</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .card-header\"><b>Quality</b><i> </i><b>Control</b></h4>\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </a>\n                                </div>\n                                <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n                                            Monitoring of fulfillment and quality standards.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .card-header\">\n                                            <b>Warranty</b>\n                                        </h4>\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </a>\n                                </div>\n                                <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">Warranty and after-sales service.</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .card-header\">\n                                            <i>Virtual</i>\n                                        </h4>\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </a>\n                                </div>\n                                <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n                                            Immerse your audience in a new dimension with our VR/AR services. Whether it's\n                                            virtual tours, interactive experiences, or augmented reality applications, our\n                                            studio pushes the boundaries of innovation to provide cutting-edge solutions.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-warning\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                CONTACT US</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u6kyzGw0G0",
          "_anchor": "list02-8",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 26px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 26px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "145px",
              "max-width": "145px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "height": "100%",
                  "display": "flex",
                  "justify-content": "center",
                  "align-items": "center",
                  ".item-img": {
                    "img": {
                      "height": "200px",
                      "object-fit": "contain"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "0",
              "width": "25px",
              "height": "25px",
              "margin-top": "-1.5rem",
              "font-size": "25px",
              "background-color": "transparent !important",
              "color": "@primaryColor !important",
              "border": "none !important",
              "border-radius": "0",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": ".6 !important"
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-top": "25px"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            }
          },
          "_name": "slider01",
          "_sourceTheme": "printm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider01 mbr-embla printm5\" group=\"Sliders &amp; Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked=\"\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"2\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked=\"\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked=\"\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            \n                            <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/1-400x400.jpg\" alt=\"Francesco Molon\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/2-400x400.jpg\" alt=\"United Alabaster Spain\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/2-400x400.png\" alt=\"Salone del mobile\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/4-400x400.png\" alt=\"Furniture Warsaw Home\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/4-400x400.jpg\" alt=\"Maison and objet\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/6-400x400.jpg\" alt=\"Maison and objet\" data-slide-to=\"5\" data-bs-slide-to=\"5\">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                            \n                            \n                            \n                            \n                            \n                            \n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u6kyBRNcTB",
          "_anchor": "slider01-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              "position": "relative",
              "z-index": "1",
              "width": "80%",
              "margin": "0 auto",
              "margin-bottom": "82px",
              "@media (max-width: 992px)": {
                "width": "100%",
                "margin-bottom": "28px"
              },
              ".label-wrapper": {
                "margin-bottom": "42px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "28px"
                },
                ".label-wrap": {
                  "padding": "14px 24px",
                  "display": "inline-flex",
                  "align-items": "center",
                  "background-color": "@labelBg",
                  "@media (max-width: 992px)": {
                    "padding": "10px 16px"
                  },
                  ".iconfont-wrapper": {
                    "display": "inline-flex",
                    "margin-right": "14px",
                    ".mbr-iconfont": {
                      "font-size": "19px"
                    }
                  },
                  ".mbr-label": {
                    "margin-bottom": "0"
                  }
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              },
              ".subtitle-wrapper": {
                ".mbr-section-subtitle": {
                  "display": "inline-block",
                  "margin-bottom": "0",
                  "-webkit-text-fill-color": "transparent",
                  "-webkit-background-clip": "text",
                  "background-clip": "text",
                  "background-image": "linear-gradient(90deg, @subtitleGradient_1, @subtitleGradient_2 50%, @subtitleGradient_3)"
                }
              }
            },
            ".items-wrapper": {
              "display": "grid",
              "grid-template-columns": ".9fr 1fr .9fr",
              "gap": "115px",
              "@media (max-width: 1440px)": {
                "gap": "56px"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".list-wrapper": {
                "position": "relative",
                "z-index": "2",
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "position": "relative",
                    "padding": "18px 24px",
                    "margin-bottom": "14px",
                    "background-color": "@cardBg",
                    "box-shadow": "0 3px 9.1px @cardShadow, 0 1px 29px @cardShadow",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "16px",
                      "padding": "18px"
                    },
                    "& when (@showMarker)": {
                      "padding": "56px 24px 18px 24px",
                      "@media (max-width: 992px)": {
                        "padding": "56px 18px 18px 18px"
                      },
                      "&::before": {
                        "content": "'✓'",
                        "position": "absolute",
                        "top": "18px",
                        "left": "24px",
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "width": "24px",
                        "height": "24px",
                        "border-radius": "100%",
                        "background-image": "linear-gradient(135deg, @marker_1, @marker_2)",
                        "color": "@markerColor",
                        "font-size": "15px"
                      }
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    }
                  }
                }
              },
              ".image-wrapper": {
                "position": "relative",
                "z-index": "1",
                "align-items": "center",
                "& when (@bg-type = 'color')": {
                  "& when (@showGradient)": {
                    ".gradient-wrap": {
                      "position": "absolute",
                      "width": "400px",
                      "height": "400px",
                      "border-radius": "100%",
                      "background-image": "linear-gradient(135deg, @gradient_1 50%, @gradient_2 40%, @gradient_3 0)",
                      "filter": "blur(10rem)",
                      "pointer-events": "none",
                      "@media (max-width: 1440px)": {
                        "width": "300px",
                        "height": "300px"
                      },
                      "@media (max-width: 425px)": {
                        "width": "260px",
                        "height": "260px"
                      }
                    }
                  }
                },
                ".image-wrap": {
                  "position": "relative",
                  "z-index": "2",
                  "width": "475px",
                  "height": "475px",
                  "border-radius": "100%",
                  "overflow": "hidden",
                  "& when (@bg-type = 'color')": {
                    "& when (@showGradient)": {
                      "padding": "10px",
                      "background-image": "linear-gradient(135deg, @gradient_1, @gradient_2 40%, @gradient_3)",
                      "@media (max-width: 992px)": {
                        "padding": "5px"
                      }
                    }
                  },
                  "@media (max-width: 1440px)": {
                    "width": "300px",
                    "height": "300px"
                  },
                  "@media (max-width: 992px)": {
                    "margin": "28px 0"
                  },
                  "@media (max-width: 425px)": {
                    "width": "260px",
                    "height": "260px"
                  },
                  "img": {
                    "width": "100%",
                    "height": "100%",
                    "object-fit": "cover",
                    "border-radius": "100% !important"
                  }
                }
              },
              ".card": {
                "justify-content": "center"
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#1a0b54",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#312911",
              "text-align": "center"
            },
            ".mbr-section-subtitle, .subtitle-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".list": {
              "color": "#1a0b54"
            },
            ".list, .item-wrap": {
              "color": "#000000"
            }
          },
          "_name": "list01",
          "_sourceTheme": "solvem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 solvem5\" group=\"List\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"color\" title=\"Label BG\" value=\"#f9f9f9\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"color\" title=\"Gradient 1\" value=\"#b8860b\" name=\"subtitleGradient_1\" condition=\"showSubtitle\" selected>\n        <input type=\"color\" title=\"Gradient 2\" value=\"#bbbbbb\" name=\"subtitleGradient_2\" condition=\"showSubtitle\" selected>\n        <input type=\"color\" title=\"Gradient 3\" value=\"#0f4229\" name=\"subtitleGradient_3\" condition=\"showSubtitle\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Marker\" name=\"showMarker\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#ffffff\" name=\"markerColor\" condition=\"showMarker\" selected>\n        <input type=\"color\" title=\"Gradient 1\" value=\"#b8860b\" name=\"marker_1\" condition=\"showMarker\" selected>\n        <input type=\"color\" title=\"Gradient 2\" value=\"#b08d57\" name=\"marker_2\" condition=\"showMarker\" selected>\n        <input type=\"color\" title=\"BG\" value=\"#ffffff\" name=\"cardBg\" selected>\n        <input type=\"color\" title=\"Shadow\" value=\"#eeeeee\" name=\"cardShadow\" selected>\n        <header condition=\"bg.type == 'color'\">Image</header>\n        <input type=\"checkbox\" title=\"Gradient\" name=\"showGradient\" checked condition=\"bg.type == 'color'\">\n        <input type=\"color\" title=\"Gradient Color 1\" value=\"#b8860b\" name=\"gradient_1\" condition=\"showGradient && bg.type == 'color'\" selected>\n        <input type=\"color\" title=\"Gradient Color 2\" value=\"#fffbf7\" name=\"gradient_2\" condition=\"showGradient && bg.type == 'color'\" selected>\n        <input type=\"color\" title=\"Gradient Color 3\" value=\"#957e7a\" name=\"gradient_3\" condition=\"showGradient && bg.type == 'color'\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/solvem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/solvem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle || showSubtitle || showLabel\">\n                    <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                        <div class=\"label-wrap\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-features mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(202, 69, 255); fill: rgb(202, 69, 255);\"></span>\n                            </div>\n                            <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                Modern Database\n                            </p>\n                        </div>\n                    </div>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Services</h2>\n                    <div class=\"subtitle-wrapper\">\n                        <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .subtitle-wrapper\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\">Our Services</h3>\n                    </div>\n                </div>\n                <div class=\"items-wrapper justify-content-center align-items-center\">\n                    <div class=\"list-wrapper card\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap little-radius\">We share the story, heritage, and key advantages of each factory we represent</li>\n                            <li class=\"item-wrap little-radius\">We introduce you to the product range and technical capabilities of the manufacturers</li>\n                            <li class=\"item-wrap little-radius\">We present the materials and finishes used in the production of their collections</li>\n                            <li class=\"item-wrap little-radius\">We deliver catalogs and finish boxes directly to your showroom or studio</li>\n                            <li class=\"item-wrap little-radius\">We assist you in project development and specification preparation</li>\n                        </ul>\n                    </div>\n                    <div class=\"image-wrapper card\">\n                        <div class=\"gradient-wrap\" mbr-if=\"showGradient\"></div>\n                        <div class=\"image-wrap\">\n                            <img src=\"@PROJECT_PATH@/assets/images/forest-green-velvet-sectional-558x740.jpeg\" alt=\"FAmeStudioAgency\">\n                        </div>\n                    </div>\n                    <div class=\"list-wrapper card\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap little-radius\">We organize training sessions and product presentations for your team</li><li class=\"item-wrap little-radius\">We help you secure the most favorable cooperation terms and best regional pricing</li>\n                            <li class=\"item-wrap little-radius\"><span style=\"font-size: 1.125rem; letter-spacing: -0.02em;\">We ensure timely production and order tracking at every stage</span><br></li>\n                            <li class=\"item-wrap little-radius\">We organize events and presentations in your showroom with a factory representative</li>\n                            <li class=\"item-wrap little-radius\">We provide post-delivery support and client care even after your order is fulfilled</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v1BAIMSlYb",
          "_anchor": "list01-g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".panel-group": {
              ".card": {
                "position": "relative",
                "padding": "0",
                "background-color": "transparent",
                "border-radius": "0 !important",
                ".card-header": {
                  "position": "relative",
                  "background-color": "transparent",
                  "border": "none",
                  "border-radius": "0",
                  "padding": "25px 30px",
                  "@media (max-width: 992px)": {
                    "padding": "20px"
                  },
                  ".panel-title": {
                    "display": "flex",
                    "justify-content": "space-between",
                    "align-items": "center",
                    "width": "100%",
                    ".panel-title-edit": {
                      "margin-bottom": "0"
                    },
                    ".icon-wrapper": {
                      "width": "40px",
                      "height": "40px",
                      "min-width": "40px",
                      "display": "inline-flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "transition": "all 0.3s ease-in-out",
                      "border-radius": "100%",
                      "margin-left": "8px",
                      ".mbr-iconfont": {
                        "font-size": "24px",
                        "transition": "all 0.3s ease-in-out",
                        "color": "@icon"
                      }
                    },
                    "&:not(.collapsed)": {
                      ".icon-wrapper": {
                        "transform": "rotate(-45deg)"
                      }
                    },
                    "&:hover": {
                      ".icon-wrapper": {
                        "background-color": "@activeBg",
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      }
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    "padding": "0 30px 20px 30px",
                    "@media (max-width: 992px)": {
                      "padding": "0 20px 20px 20px"
                    },
                    ".panel-text": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".panel-title-edit": {
              "color": "#212529"
            },
            ".panel-text": {
              "color": "#51565c"
            }
          },
          "_name": "list02",
          "_sourceTheme": "flavorm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list02 flavorm5\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <input type=\"color\" title=\"Icon Color\" value=\"#212529\" name=\"icon\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#ffffff\" name=\"active\" selected>\n        <input type=\"color\" title=\"Active BG\" value=\"#b8860b\" name=\"activeBg\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/flavorm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/flavorm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-5\"></div>\n            <div class=\"col-12 col-lg-7\">\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Why Choose FAme Studio?\n                                </h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">What sets FAme Studio apart is our commitment to quality, focus, and personal service.&nbsp;We have developed a unique presentation program, allowing us to introduce a factory to dozens of design professionals in any city within just one day.<br><br>We represent only a select portfolio of manufacturers, ensuring maximum attention to each brand.<br><br>We work exclusively with global brands that have an impeccable reputation and proven excellence.<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">How can I receive the complete set of catalogs, price lists, and partnership terms from the factory?<div><br></div></h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">Simply fill out the registration form on our website, and we’ll send you a download link to access the full catalog collection, the current price list and cooperation terms for any of our factories.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">How can I get 3D models of specific products?\n                                </h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">Complete the registration form on our website, and we’ll send you a download link with the 3D models you need from any of our partner factories.<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">How can I request a finishes sample box for my project?</h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n                                    Submit the registration form on our website, and we’ll contact you immediately. We guarantee delivery of a sample box within <b>24 hours</b>.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Can I organize a presentation or event in my showroom with a factory representative?\n                                </h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">Yes, we provide full assistance in organizing local events and presentations together with our partner factories, with a strong focus on sales and client engagement.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">Do you provide delivery of finished products to my office or project site?\n                                </h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n                                     Yes. We offer a complete range of services — from introducing you to the factory to managing delivery and installation of finished products at your location.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v1AJC63CnM",
          "_anchor": "list02-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 26px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 26px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              "padding": "200px 60px",
              "background-color": "@container",
              "border-radius": "20px",
              "@media (max-width: 992px)": {
                "padding": "100px 20px"
              },
              ".title-wrapper": {
                "margin-bottom": "100px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                ".mbr-title": {
                  "margin-bottom": "30px"
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-flex",
                    "margin-bottom": "0",
                    "width": "50%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              },
              ".content-wrap": {
                "display": "flex",
                "@media (max-width: 992px)": {
                  "display": "block"
                },
                ".contacts-wrapper": {
                  "width": "50%",
                  "padding-right": "45px",
                  "margin-bottom": "0",
                  "& when (@reverseContent)": {
                    "padding-right": "0",
                    "padding-left": "45px",
                    "@media (max-width: 992px)": {
                      "padding-left": "0"
                    }
                  },
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "padding-right": "0",
                    "margin-bottom": "40px"
                  },
                  ".mbr-section-subtitle": {
                    "margin-bottom": "20px"
                  },
                  ".list": {
                    "margin": "0",
                    "padding": "0",
                    "list-style-type": "none",
                    ".item-wrap": {
                      "transition": "all 0.3s ease-in-out",
                      "margin-bottom": "5px",
                      "cursor": "pointer",
                      "&:hover, &:focus": {
                        "opacity": ".6"
                      }
                    }
                  }
                }
              },
              ".form-wrap": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%"
                },
                ".dragArea.row": {
                  ".mbr-section-title": {
                    "margin-bottom": "16px !important"
                  },
                  ".mbr-text": {
                    "margin-bottom": "16px !important"
                  },
                  ".form-group": {
                    "margin-bottom": "10px !important",
                    "padding": "0 8px",
                    ".form-control-label": {
                      "width": "100%",
                      "margin-bottom": "16px"
                    },
                    ".form-control": {
                      "padding": "8px 16px",
                      "border": "1px solid @border !important",
                      "box-shadow": "none",
                      "border-radius": "3px !important",
                      "background-color": "transparent",
                      "transition": "all 0.3s ease-in-out",
                      "font-size": "18px",
                      "&:hover, &:focus": {
                        "border": "1px solid @active !important"
                      },
                      "&::placeholder": {
                        "color": "@active",
                        "font-size": "18px",
                        "opacity": ".5"
                      }
                    },
                    "textarea": {
                      "min-height": "50px"
                    },
                    ".form-check": {
                      "padding-left": "1.9em",
                      "margin-bottom": "16px",
                      ".form-check-input": {
                        "background-color": "transparent",
                        "border-color": "@border",
                        "border-radius": "3px",
                        "margin-top": "2px"
                      }
                    }
                  },
                  ".mbr-section-btn": {
                    "width": "100%",
                    "margin": "0",
                    "padding": "0"
                  }
                }
              }
            },
            ".mbr-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#000000"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".list": {
              "color": "#000000"
            },
            "label": {
              "color": "#000000"
            },
            ".mbr-section-btn": {
              "text-align": "center"
            },
            ".mbr-title, .mbr-section-btn": {
              "color": "#312911"
            }
          },
          "_name": "form01",
          "_sourceTheme": "printm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 printm5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#f4f1f1\" name=\"container\" selected>\n        <header>Form</header>\n        <input type=\"color\" title=\"Border Color\" value=\"#69727d\" name=\"border\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#000000\" name=\"active\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"title-wrapper\" mbr-if=\"showTitle || showText\">\n                        <h2 class=\"mbr-title mbr-fonts-style\" data-app-selector=\".mbr-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Contact Us</b>\n                        </h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Do you need the full set of catalogs, factory price lists and partnership terms, 3D models of specific products, a finishes sample box for your project, or do you have any other questions?\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"contacts-wrapper\" mbr-if=\"showContacts || showSubtitle\">\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                                Contacts\n                            </h3>\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showContacts\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">+48 793 616 704</li>\n                                <li class=\"item-wrap\">hello.famestudio@gmail.com</li>\n                            </ul>\n                        </div>\n                        <div mbr-form class=\"mbr-form form-wrap\">\n<!--Formbuilder Form-->\n<form action=\"hello.famestudio@gmail.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"hello.famestudio@gmail.com\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling out the form!</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12\">\n<h3 mbr-theme-style=\"display-5\" class=\"mbr-section-title mbr-fonts-style\"> Fill in the form </h3>\n</div>\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3 mb-3\" data-for=\"text\">\n<input type=\"text\" name=\"text\" placeholder=\"First name:\" data-form-field=\"text\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\" value>\n</div>\n<div data-for=\"text1\" class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3 mb-3\">\n<input type=\"text\" name=\"text1\" placeholder=\"Last name:\" data-form-field=\"text1\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n</div>\n<div data-for=\"email\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3 mb-3 mb-3\">\n<input type=\"email\" name=\"email\" placeholder=\"E-mail:\" data-form-field=\"email\" mbr-theme-style=\"display-4\" class=\"form-control\" required=\"required\" value>\n</div>\n<div data-for=\"Phone:\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<input type=\"tel\" name=\"Phone:\" data-form-field=\"Phone:\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" placeholder=\"Phone:\" value>\n</div>\n<div data-for=\"textarea\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3 mb-3\">\n<textarea name=\"textarea\" placeholder=\"Message: How can I receive the complete set of catalogs?\" data-form-field=\"textarea\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<div class=\"form-control-label\">\n</div>\n<div data-for=\"I agree to the processing of personal data\" class=\"form-check ms-2\" hidden=\"hidden\">\n<input type=\"checkbox\" value=\"Yes\" name=\"I agree to the processing of personal data\" data-form-field=\"I agree to the processing of personal data\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-check-input\" hidden=\"hidden\">\n<label mbr-text for=\"I agree to the processing of personal data\" mbr-theme-style=\"display-4\" class=\"form-check-label\" hidden=\"hidden\">I agree to the processing of personal data</label>\n</div>\n</div>\n<div mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col mbr-section-btn\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 w-100 btn btn-warning\"> Send now </a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v1zYPQGe6D",
          "_anchor": "form01-1",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 26px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 26px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              "margin-bottom": "70px",
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              ".logo-wrapper": {
                "margin-bottom": "70px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                "img": {
                  "height": "90px",
                  "width": "90px",
                  "display": "inline-flex",
                  "object-fit": "contain",
                  "border-radius": "0 !important"
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "70px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                }
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-flex",
                  "width": "70%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              }
            },
            ".content-wrapper": {
              "margin-bottom": "60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              ".nav-wrapper": {
                "margin-bottom": "70px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px",
                  "text-align": "left"
                },
                ".list": {
                  "margin": "0",
                  "padding": "0",
                  "list-style-type": "none",
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".item-wrap": {
                    "margin": "0 50px 16px 0",
                    "transition": "all 0.3s ease-in-out",
                    "cursor": "pointer",
                    "@media (max-width: 992px)": {
                      "margin": "0 25px 16px 0"
                    },
                    "&:hover, &:focus": {
                      "color": "@navActive"
                    },
                    "&:last-child": {
                      "margin": "0 0 16px 0"
                    }
                  }
                }
              },
              ".contacts-wrapper": {
                "margin-bottom": "70px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                ".list": {
                  "margin": "0",
                  "padding": "0",
                  "list-style-type": "none",
                  "@media (max-width: 992px)": {
                    "text-align": "left"
                  },
                  ".item-wrap": {
                    "margin-bottom": "0",
                    "font-family": "\"Instrument Serif\", sans-serif",
                    "transition": "all 0.3s ease-in-out",
                    "cursor": "pointer",
                    "letter-spacing": "-0.02em",
                    "&:hover, &:focus": {
                      "color": "@active"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    }
                  }
                }
              },
              ".social-wrapper": {
                "@media (max-width: 992px)": {
                  "text-align": "left"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "&:last-child": {
                      "a .mbr-iconfont": {
                        "margin-right": "0"
                      }
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:hover": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "display": "flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "width": "40px",
                        "height": "40px",
                        "color": "@socColor",
                        "font-size": "40px",
                        "transition": "all 0.3s ease-in-out",
                        "margin-right": "25px"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-copy": {
              "margin-bottom": "0",
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#ffffff"
            },
            ".list, .nav-wrapper, .social-wrapper": {
              "text-align": "right"
            },
            ".list, .item-wrap, .social-wrapper": {
              "color": "#f4f1f1"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "printm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 printm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"color\" title=\"Navigation Active Color\" value=\"#f4f1f1\" name=\"navActive\" condition=\"showNav\" selected>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"5\" step=\"1\" value=\"1\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#bbbbbb\" name=\"active\" condition=\"showSocial || showContacts\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#4f4521\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showLogo || showTitle || showText\">\n                <div class=\"title-wrapper\">\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <img src=\"@THEME_PATH@/components/_images/logo.png\" alt=\"Mobirise\">\n                    </div>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .logo-wrapper\">\n                        <b>FAmeStudioAgency</b></h2>\n                    <div class=\"text-wrapper\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">As the official representative of world-renowned furniture and lighting manufacturers in Europe (Germany, Austria, and Poland), we connect factories with local distributors, designers, and retailers through personalized support and deep industry expertise<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5\">\n                <div class=\"content-wrapper\" mbr-if=\"showNav || showContacts || showSocial\">\n                    <div class=\"nav-wrapper\" mbr-if=\"showNav\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .nav-wrapper, .social-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><b><a href=\"index.html#article02-3\" class=\"text-white\">About</a></b></li>\n                            <li class=\"item-wrap\"><b><a href=\"index.html#slider05-c\" class=\"text-white\">Brands</a></b></li><a href=\"index.html#slider05-c\" class=\"text-primary\">\n                            </a><li class=\"item-wrap\"><b><a href=\"index.html#list01-g\" class=\"text-white\">Services</a></b></li>\n                        </ul>\n                    </div>\n                    <div class=\"contacts-wrapper\" mbr-if=\"showContacts\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap, .social-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\">hello.famestudio@gmail.com</li>\n                            <li class=\"item-wrap\">+48 793 616 704</li>\n                        </ul>\n                    </div>\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://www.instagram.com/fame_studio_poland/\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 4\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-linkedin\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-10\">\n                <p class=\"mbr-copy mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\" data-app-selector=\".mbr-copy\">\n                    © Copyright FAmeStudioAgency 2025 - All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u6kyx6blOo",
          "_anchor": "footer01-7",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    }
  }
}